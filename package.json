{
  "name": "@sudobility/printing",
  "version": "0.1.0",
  "description": "Web printing for @sudobility apps (CSS @page, detached print, draw-readiness)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/fix-esm-imports.mjs",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "prepublishOnly": "bun run clean && bun run test:unit && bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src/**/*.{ts,tsx,js}"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "keywords": [
    "dependency-injection",
    "di",
    "web",
    "web3"
  ],
  "author": "Sudobility Inc",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/printing_core": "^0.1.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/di_web.git"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@sudobility/printing_core": "^0.1.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "~26.6.5",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "@vitest/coverage-v8": "~4.1.12",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "jsdom": "~30.1.3",
    "prettier": "~3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
